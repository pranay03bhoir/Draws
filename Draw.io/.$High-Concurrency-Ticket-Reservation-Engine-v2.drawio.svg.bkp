; color: light-dark(transparent, rgb(0, 255, 128));&amp;quot;&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,0,0,0&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;&amp;lt;b data-path-to-node=&amp;quot;2,0,0,0&amp;quot; data-index-in-node=&amp;quot;0&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;The Core Gateway Flow:&amp;lt;/b&amp;gt; Finalize the &amp;lt;code data-path-to-node=&amp;quot;2,0,0,0&amp;quot; data-index-in-node=&amp;quot;36&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;POST /api/v1/reservations&amp;lt;/code&amp;gt; controller along with the &amp;lt;code data-path-to-node=&amp;quot;2,0,0,0&amp;quot; data-index-in-node=&amp;quot;88&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;ReservationService&amp;lt;/code&amp;gt; using the atomic Lua script and &amp;lt;code data-path-to-node=&amp;quot;2,0,0,0&amp;quot; data-index-in-node=&amp;quot;139&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;StringRedisTemplate&amp;lt;/code&amp;gt;&amp;lt;/span&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,0,0,1&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;&amp;lt;sup class=&amp;quot;superscript&amp;quot;&amp;gt;&amp;lt;/sup&amp;gt;&amp;lt;/span&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,0,0,2&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;.&amp;lt;/span&amp;gt;&amp;lt;/font&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;/li&amp;gt;&amp;lt;li&amp;gt;&amp;lt;p data-path-to-node=&amp;quot;2,1,0&amp;quot; id=&amp;quot;p-rc_031a66cb11274453-293&amp;quot;&amp;gt;&amp;lt;font style=&amp;quot;font-size: 19px; color: light-dark(transparent, rgb(0, 255, 128));&amp;quot;&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,1,0,0&amp;quot;&amp;gt;&amp;lt;b data-path-to-node=&amp;quot;2,1,0,0&amp;quot; data-index-in-node=&amp;quot;0&amp;quot;&amp;gt;Kafka Producer Integration:&amp;lt;/b&amp;gt; Publish the immutable &amp;lt;code data-path-to-node=&amp;quot;2,1,0,0&amp;quot; data-index-in-node=&amp;quot;50&amp;quot;&amp;gt;ReservationEvent&amp;lt;/code&amp;gt; to the &amp;lt;code data-path-to-node=&amp;quot;2,1,0,0&amp;quot; data-index-in-node=&amp;quot;74&amp;quot;&amp;gt;reservation.pending&amp;lt;/code&amp;gt; topic directly after a successful Redis hold&amp;lt;/span&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,1,0,1&amp;quot;&amp;gt;&amp;lt;sup class=&amp;quot;superscript&amp;quot;&amp;gt;&amp;lt;/sup&amp;gt;&amp;lt;/span&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,1,0,2&amp;quot;&amp;gt;.&amp;lt;/span&amp;gt;&amp;lt;/font&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;/li&amp;gt;&amp;lt;li&amp;gt;&amp;lt;p data-path-to-node=&amp;quot;2,2,0&amp;quot; id=&amp;quot;p-rc_031a66cb11274453-294&amp;quot;&amp;gt;&amp;lt;font style=&amp;quot;font-size: 19px; color: light-dark(transparent, rgb(0, 255, 128));&amp;quot;&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,2,0,0&amp;quot;&amp;gt;&amp;lt;b data-path-to-node=&amp;quot;2,2,0,0&amp;quot; data-index-in-node=&amp;quot;0&amp;quot;&amp;gt;Downstream Worker Implementation:&amp;lt;/b&amp;gt; Build the &amp;lt;code data-path-to-node=&amp;quot;2,2,0,0&amp;quot; data-index-in-node=&amp;quot;44&amp;quot;&amp;gt;Order &amp;amp;amp; Payment Worker&amp;lt;/code&amp;gt; to consume the Kafka event, check PostgreSQL for duplicate idempotency keys, and run the mock payment logic&amp;lt;/span&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,2,0,1&amp;quot;&amp;gt;&amp;lt;sup class=&amp;quot;superscript&amp;quot;&amp;gt;&amp;lt;/sup&amp;gt;&amp;lt;/span&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,2,0,2&amp;quot;&amp;gt;.&amp;lt;/span&amp;gt;&amp;lt;/font&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;/li&amp;gt;&amp;lt;li&amp;gt;&amp;lt;p data-path-to-node=&amp;quot;2,3,0&amp;quot; id=&amp;quot;p-rc_031a66cb11274453-295&amp;quot;&amp;gt;&amp;lt;font style=&amp;quot;font-size: 19px; color: light-dark(transparent, rgb(0, 255, 128));&amp;quot;&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,3,0,0&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;&amp;lt;b data-path-to-node=&amp;quot;2,3,0,0&amp;quot; data-index-in-node=&amp;quot;0&amp;quot;&amp;gt;Saga Compensating Rollback:&amp;lt;/b&amp;gt; Implement the &amp;lt;code data-path-to-node=&amp;quot;2,3,0,0&amp;quot; data-index-in-node=&amp;quot;42&amp;quot;&amp;gt;reservation.failed&amp;lt;/code&amp;gt; listener to trigger &amp;lt;code data-path-to-node=&amp;quot;2,3,0,0&amp;quot; data-index-in-node=&amp;quot;81&amp;quot;&amp;gt;INCR&amp;lt;/code&amp;gt; in Redis if payment fails or times out&amp;lt;/span&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,3,0,1&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;&amp;lt;sup class=&amp;quot;superscript&amp;quot;&amp;gt;&amp;lt;/sup&amp;gt;&amp;lt;/span&amp;gt;&amp;lt;span data-path-to-node=&amp;quot;2,3,0,2&amp;quot; style=&amp;quot;&amp;quot;&amp;gt;.&amp;lt;/span&amp;gt;&amp;lt;/font&amp;gt;&amp;lt;/p&amp;gt;&amp;lt;/li&amp;gt;&amp;lt;/ol&amp;gt;&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;400&quot; width=&quot;849&quot; x=&quot;521&quot; y=&quot;1080&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;      &lt;/root&gt;&#10;    &lt;/mxGraphModel&gt;&#10;  &lt;/diagram&gt;&#10;&lt;/mxfile&gt;&#10;"><style type="text/css">@supports (color: light-dark(#000, #fff)) { #ge-svg-jIkNaiEvfdskIu6qkd3D { --ge-adaptive-bg: light-dark(#ffffff, var(--ge-dark-color, #121212)); } }</style><defs><clipPath id="mx-clippath-inset-0-0-0-0-round-14-999999999999998-3" clipPathUnits="objectBoundingBox"><rect x="0" y="0" width="1" height="1" rx="0.15" ry="0.15"/></clipPath><clipPath id="mx-clippath-inset-0-0-0-0-round-15-2" clipPathUnits="objectBoundingBox"><rect x="0" y="0" width="1" height="1" rx="0.15" ry="0.15"/></clipPath><clipPath id="mx-clippath-inset-0-0-0-0-round-15-2" clipPathUnits="objectBoundingBox"><rect x="0" y="0" width="1" height="1" rx="0.15" ry="0.15"/></clipPath><symbol id="mx-image-1hddwl1" viewBox="0 0 48 64"><image width="48" height="64" xlink:href="file:///opt/drawio/resources/app.asar/drawio/src/main/webapp/img/lib/azure2/databases/Azure_Database_PostgreSQL_Server.svg"/></symbol><c